# Claude Code のローカル設定（マシン固有・共有しない）
.claude/

# Google Drive API の秘密情報（drive_cleanup.py）— 絶対にコミットしない
credentials.json
token.json

# drive_cleanup.py の実行ログ
tools/logs/

# Pythonの生成物
__pycache__/

# 全OSバックアップのローカルコピー（誤ってリポジトリに置いてもコミットしない）
*.backup.json
myapps-all-backup-*.json
myapps-weekly-*.json

# weekly_facts.py の生成物（Coworkの作業フォルダへコピーして使う）
weekly_facts.json
aix_weekly_facts.json

# シート台帳の実データ（プロジェクト名・spreadsheetIdは個人情報。公開リポジトリに載せない）
docs/sheets.local.md
sheet_*.tsv

# 議事録の原文と振り分け結果は個人情報。このリポジトリは公開なのでフォルダだけ残して中身は追跡しない
inbox/*
!inbox/.gitkeep
!inbox/processed/
inbox/processed/*
!inbox/processed/.gitkeep
outputs/*
!outputs/.gitkeep
